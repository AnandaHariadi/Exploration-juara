# CLARA AI service (backend/). Copy to backend/.env and fill in. Never commit .env.

# Server
PORT=3001
NODE_ENV=development

# Required for AI features (contract extraction, legal Q&A). Server-side only.
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# Shared secret with the Next.js app (frontend/.env.local CLARA_AI_SERVICE_KEY). Leave both empty for local dev.
AI_SERVICE_KEY=

# Optional: Neo4j legal knowledge graph for RAG citations. Without it, answers use project data + model knowledge.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Optional: legacy async OCR queue. Leave false unless Redis is running.
ENABLE_QUEUE=false
REDIS_URL=redis://localhost:6379

# Legacy standalone CLARA features (OAuth login, JWT-protected routes). Not used by the business app.
JWT_SECRET=change_me
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAX_FILE_SIZE_MB=10
