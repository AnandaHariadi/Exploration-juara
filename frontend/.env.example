# CLARA business app (frontend/). Copy to frontend/.env.local. Server-side only — no NEXT_PUBLIC_ values needed.

# URL of the CLARA AI service (backend/). The browser never calls it directly.
CLARA_AI_URL=http://localhost:3001
# Must equal AI_SERVICE_KEY in backend/.env (leave both empty for local dev).
CLARA_AI_SERVICE_KEY=
# Max wait for one contract analysis, in ms.
CLARA_AI_TIMEOUT_MS=150000
